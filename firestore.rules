rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // High-entropy invite tokens: minimum 24 chars, INV- prefix, Base32/alphanumeric + dashes
    function isValidInviteTokenId(token) {
      return token is string &&
             token.size() >= 24 &&
             token.size() <= 64 &&
             token.matches('^INV-[A-Z0-9_\\-]{20,60}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidStringList(listVal, maxLen) {
      return listVal is list &&
             listVal.size() <= maxLen &&
             (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 500)) &&
             (listVal.size() <= 1 || (listVal[listVal.size() - 1] is string && listVal[listVal.size() - 1].size() <= 500));
    }

    // --- Group Membership & Role Helpers (v2 Subcollection + Legacy v1 Read Fallback) ---
    function hasV2MemberDoc(groupId, uid) {
      return isValidId(groupId) &&
             exists(/databases/$(database)/documents/groups/$(groupId)) &&
             exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)) &&
             get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data.groupId == groupId &&
             get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data.joinedAt is timestamp &&
             get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data.joinedAt >=
               get(/databases/$(database)/documents/groups/$(groupId)).data.createdAt;
    }

    function v2MemberRole(groupId, uid) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data.role;
    }

    function isLegacyGroupMember(groupId, uid) {
      return isValidId(groupId) &&
             exists(/databases/$(database)/documents/groups/$(groupId)) &&
             'memberIds' in get(/databases/$(database)/documents/groups/$(groupId)).data &&
             get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds is list &&
             uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupMember(groupId) {
      return isSignedIn() && (
        hasV2MemberDoc(groupId, request.auth.uid) ||
        isLegacyGroupMember(groupId, request.auth.uid)
      );
    }

    function isGroupOwner(groupId) {
      return isSignedIn() && isValidId(groupId) && (
        (hasV2MemberDoc(groupId, request.auth.uid) && v2MemberRole(groupId, request.auth.uid) == 'OWNER') ||
        (exists(/databases/$(database)/documents/groups/$(groupId)) &&
         get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid)
      );
    }

    function isGroupAdminOrOwner(groupId) {
      return isSignedIn() && isValidId(groupId) && (
        isGroupOwner(groupId) ||
        (hasV2MemberDoc(groupId, request.auth.uid) && v2MemberRole(groupId, request.auth.uid) in ['OWNER', 'ADMIN'])
      );
    }

    // 0A. SocialGroup Validation Blueprint (v2 decoupled from invite tokens & member arrays)
    function isValidV2Group(data) {
      return data.keys().hasAll(['name', 'createdBy', 'schemaVersion', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['name', 'createdBy', 'schemaVersion', 'createdAt', 'updatedAt']) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.schemaVersion == 2 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Legacy v1 group schema validation (allowed ONLY for owner maintenance/pruning on existing docs)
    function isValidLegacyGroup(data) {
      return data.keys().hasAll([
               'name', 'inviteCode', 'createdBy', 'memberIds', 'memberNames', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'name', 'inviteCode', 'createdBy', 'memberIds', 'memberNames', 'createdAt', 'updatedAt', 'schemaVersion'
             ]) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.inviteCode is string && data.inviteCode.size() >= 1 && data.inviteCode.size() <= 32 &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             isValidStringList(data.memberIds, 50) &&
             data.memberNames is map && data.memberNames.size() <= 50 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 0B. Per-Member Document Validation (/groups/{groupId}/members/{memberUid})
    function isValidGroupMember(data, groupId, memberUid) {
      return data.keys().hasAll(['userId', 'groupId', 'displayName', 'role', 'inviteToken', 'joinedAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'groupId', 'displayName', 'role', 'inviteToken', 'joinedAt', 'updatedAt']) &&
             data.userId is string && data.userId == memberUid &&
             data.groupId is string && data.groupId == groupId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.role is string && data.role in ['OWNER', 'ADMIN', 'MEMBER'] &&
             data.inviteToken is string && data.inviteToken.size() <= 64 &&
             data.joinedAt is timestamp && data.joinedAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 0C. High-Entropy Revocable Invite Validation (/group_invites/{token})
    function isValidGroupInvite(data, tokenId) {
      return data.keys().hasAll([
               'token', 'groupId', 'groupNamePreview', 'createdBy',
               'revoked', 'expiresAt', 'maxUses', 'useCount',
               'lastRedeemedBy', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'token', 'groupId', 'groupNamePreview', 'createdBy',
               'revoked', 'expiresAt', 'maxUses', 'useCount',
               'lastRedeemedBy', 'createdAt', 'updatedAt'
             ]) &&
             isValidInviteTokenId(tokenId) &&
             data.token is string && data.token == tokenId &&
             isValidId(data.groupId) &&
             data.groupNamePreview is string && data.groupNamePreview.size() >= 1 && data.groupNamePreview.size() <= 80 &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.revoked is bool &&
             data.expiresAt is timestamp &&
             data.maxUses is int && data.maxUses >= 1 && data.maxUses <= 100 &&
             data.useCount is int && data.useCount >= 0 && data.useCount <= data.maxUses &&
             data.lastRedeemedBy is string && data.lastRedeemedBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /groups/{groupId} {
      // Strictly members-only: knowing groupId leaks ZERO private group data to non-members.
      allow get: if isGroupMember(groupId);
      allow list: if isSignedIn() && (
        ('memberIds' in resource.data && request.auth.uid in resource.data.memberIds) ||
        hasV2MemberDoc(groupId, request.auth.uid)
      );

      // New groups must use v2 schema and atomically create the creator's OWNER member doc.
      allow create: if isSignedIn() &&
                       isValidId(groupId) &&
                       isValidV2Group(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
                       getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'OWNER';

      // Closed self-join door: nobody can self-join or add third parties via /groups/{groupId} update.
      // Only OWNER/ADMIN can rename; only OWNER can prune legacy memberIds (strict subset, never adding UIDs).
      allow update: if isSignedIn() &&
                       isValidId(groupId) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           isValidV2Group(incoming()) &&
                           isGroupAdminOrOwner(groupId) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
                         ) ||
                         (
                           isValidLegacyGroup(incoming()) &&
                           incoming().inviteCode == existing().inviteCode &&
                           (
                             (isGroupAdminOrOwner(groupId) &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])) ||
                             (isGroupOwner(groupId) &&
                              existing().memberIds.hasAll(incoming().memberIds) &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'memberNames', 'updatedAt']))
                           )
                         )
                       );

      // Client deletion is deliberately fail-closed: Firestore Rules cannot enumerate and
      // atomically tombstone every member/invite descendant. A privileged migration may
      // delete a complete subtree, but this client surface must never create orphans.
      allow delete: if false;

      // Per-member subcollection: eliminates concurrent join races & arbitrary member tampering
      match /members/{memberUid} {
        // A signed-in user may check their own member doc (for atomic idempotent join);
        // non-members get exists=false identically whether groupId exists or not (zero info leak).
        // Reading other members or listing the subcollection strictly requires membership.
        allow get: if isSignedIn() &&
                      isValidId(groupId) &&
                      isValidId(memberUid) &&
                      ((memberUid == request.auth.uid &&
                        !exists(/databases/$(database)/documents/groups/$(groupId)/members/$(memberUid))) ||
                       isGroupMember(groupId));
        allow list: if isGroupMember(groupId);

        allow create: if isSignedIn() &&
                         isValidId(groupId) &&
                         isValidId(memberUid) &&
                         memberUid == request.auth.uid &&
                         isValidGroupMember(incoming(), groupId, memberUid) &&
                         (
                           // Case 1: Group creator initializing OWNER member doc in the same atomic batch as group creation
                           (
                             !exists(/databases/$(database)/documents/groups/$(groupId)) &&
                             existsAfter(/databases/$(database)/documents/groups/$(groupId)) &&
                             getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid &&
                             getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdAt <= incoming().joinedAt &&
                             incoming().role == 'OWNER' &&
                             incoming().inviteToken == ''
                           ) ||
                           // Case 2: Atomic invite redemption coupled via getAfter() with /group_invites/{token}
                           (
                             exists(/databases/$(database)/documents/groups/$(groupId)) &&
                             incoming().role == 'MEMBER' &&
                             isValidInviteTokenId(incoming().inviteToken) &&
                             exists(/databases/$(database)/documents/group_invites/$(incoming().inviteToken)) &&
                             get(/databases/$(database)/documents/group_invites/$(incoming().inviteToken)).data.createdAt >=
                               get(/databases/$(database)/documents/groups/$(groupId)).data.createdAt &&
                             get(/databases/$(database)/documents/group_invites/$(incoming().inviteToken)).data.groupId == groupId &&
                             get(/databases/$(database)/documents/group_invites/$(incoming().inviteToken)).data.revoked == false &&
                             get(/databases/$(database)/documents/group_invites/$(incoming().inviteToken)).data.expiresAt > request.time &&
                             get(/databases/$(database)/documents/group_invites/$(incoming().inviteToken)).data.useCount <
                               get(/databases/$(database)/documents/group_invites/$(incoming().inviteToken)).data.maxUses &&
                             getAfter(/databases/$(database)/documents/group_invites/$(incoming().inviteToken)).data.useCount ==
                               get(/databases/$(database)/documents/group_invites/$(incoming().inviteToken)).data.useCount + 1 &&
                             getAfter(/databases/$(database)/documents/group_invites/$(incoming().inviteToken)).data.lastRedeemedBy == request.auth.uid
                           ) ||
                           // Case 3: Reversible self-backfill for ALREADY-EXISTING legacy memberIds members only
                           (
                             isLegacyGroupMember(groupId, request.auth.uid) &&
                             incoming().inviteToken == '' &&
                             incoming().role == (
                               get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
                                 ? 'OWNER'
                                 : 'MEMBER'
                             )
                           )
                         );

        allow update: if isSignedIn() &&
                         isValidId(groupId) &&
                         isValidId(memberUid) &&
                         isValidGroupMember(incoming(), groupId, memberUid) &&
                         incoming().userId == existing().userId &&
                         incoming().groupId == existing().groupId &&
                         incoming().inviteToken == existing().inviteToken &&
                         incoming().joinedAt == existing().joinedAt &&
                         (
                           // Self-update: displayName only (cannot escalate own role)
                           (
                             memberUid == request.auth.uid &&
                             isGroupMember(groupId) &&
                             incoming().role == existing().role &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
                           ) ||
                           // Owner role management: promote/demote MEMBER <-> ADMIN (cannot alter OWNER)
                           (
                             isGroupOwner(groupId) &&
                             memberUid != request.auth.uid &&
                             existing().role != 'OWNER' &&
                             incoming().role in ['ADMIN', 'MEMBER'] &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
                           )
                         );

        allow delete: if isSignedIn() &&
                         isValidId(groupId) &&
                         isValidId(memberUid) &&
                         existing().role != 'OWNER' &&
                         (
                           // Self leave (non-owner)
                           memberUid == request.auth.uid ||
                           // Owner can remove ADMIN or MEMBER; ADMIN can remove MEMBER only
                           isGroupOwner(groupId) ||
                           (isGroupAdminOrOwner(groupId) && existing().role == 'MEMBER')
                         );
      }
    }

    match /group_invites/{token} {
      // Non-members can ONLY fetch an active, unrevoked, unexpired, unexhausted invite if they possess the 160-bit token ID.
      // Revoked/expired/exhausted/non-existent invites are denied (prevents status oracle and stale preview leaks).
      allow get: if isSignedIn() &&
                    isValidInviteTokenId(token) &&
                    resource != null &&
                      (
                        isGroupAdminOrOwner(resource.data.groupId) ||
                        (
                          exists(/databases/$(database)/documents/groups/$(resource.data.groupId)) &&
                          resource.data.createdAt >=
                            get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.createdAt &&
                          resource.data.revoked == false &&
                        resource.data.expiresAt > request.time &&
                        resource.data.useCount < resource.data.maxUses
                      )
                    );

      // Only OWNER/ADMIN of a group can list invites belonging to their group (zero global enumeration).
      allow list: if isSignedIn() && isGroupAdminOrOwner(resource.data.groupId);

      allow create: if isSignedIn() &&
                       isValidGroupInvite(incoming(), token) &&
                       isGroupAdminOrOwner(incoming().groupId) &&
                       exists(/databases/$(database)/documents/groups/$(incoming().groupId)) &&
                       incoming().createdAt >=
                         get(/databases/$(database)/documents/groups/$(incoming().groupId)).data.createdAt &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().revoked == false &&
                       incoming().useCount == 0 &&
                       incoming().lastRedeemedBy == '' &&
                       incoming().expiresAt > request.time;

      allow update: if isSignedIn() &&
                       isValidGroupInvite(incoming(), token) &&
                       incoming().token == existing().token &&
                       incoming().groupId == existing().groupId &&
                       incoming().groupNamePreview == existing().groupNamePreview &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().expiresAt == existing().expiresAt &&
                       incoming().maxUses == existing().maxUses &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Case 1: OWNER/ADMIN revoking an invite
                         (
                           isGroupAdminOrOwner(existing().groupId) &&
                           incoming().revoked == true &&
                           incoming().useCount == existing().useCount &&
                           incoming().lastRedeemedBy == existing().lastRedeemedBy &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['revoked', 'updatedAt'])
                         ) ||
                         // Case 2: Atomic redemption coupled with creating /groups/{groupId}/members/{uid}
                         (
                           existing().revoked == false &&
                           exists(/databases/$(database)/documents/groups/$(existing().groupId)) &&
                           existing().createdAt >=
                             get(/databases/$(database)/documents/groups/$(existing().groupId)).data.createdAt &&
                           incoming().revoked == false &&
                           existing().expiresAt > request.time &&
                           existing().useCount < existing().maxUses &&
                           incoming().useCount == existing().useCount + 1 &&
                           incoming().lastRedeemedBy == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['useCount', 'lastRedeemedBy', 'updatedAt']) &&
                           !exists(/databases/$(database)/documents/groups/$(existing().groupId)/members/$(request.auth.uid)) &&
                           !isLegacyGroupMember(existing().groupId, request.auth.uid) &&
                           existsAfter(/databases/$(database)/documents/groups/$(existing().groupId)/members/$(request.auth.uid)) &&
                           getAfter(/databases/$(database)/documents/groups/$(existing().groupId)/members/$(request.auth.uid)).data.inviteToken == token
                         )
                       );

      allow delete: if isSignedIn() && isGroupAdminOrOwner(existing().groupId);
    }

    // 1. UserProfile Validation Blueprint
    function isValidUserProfile(data) {
      return data.keys().hasAll([
               'userId', 'username', 'bio', 'avatarUrl', 'curiosities',
               'groupId', 'groupInviteCode', 'groupName', 'gamesHighScore',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'username', 'bio', 'avatarUrl', 'curiosities',
               'groupId', 'groupInviteCode', 'groupName', 'gamesHighScore',
               'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 60 &&
             data.bio is string && data.bio.size() <= 300 &&
             data.avatarUrl is string && data.avatarUrl.size() <= 500 &&
             isValidStringList(data.curiosities, 20) &&
             data.groupId is string && data.groupId.size() <= 128 &&
             data.groupInviteCode is string && data.groupInviteCode.size() <= 32 &&
             data.groupName is string && data.groupName.size() <= 80 &&
             data.gamesHighScore is int && data.gamesHighScore >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'username', 'bio', 'avatarUrl', 'curiosities',
                         'groupId', 'groupInviteCode', 'groupName', 'gamesHighScore', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 2. Outing Validation Blueprint (kept compatible with upcoming AI Studio content-creation rules)
    function isValidOuting(data) {
      return data.keys().hasAll([
               'ownerId', 'groupId', 'title', 'location', 'meetingPoint',
               'dateIso', 'time', 'status', 'budgetPerPerson', 'kitItems',
               'additionalInfo', 'placePhotoUrl', 'destLat', 'destLng',
               'meetLat', 'meetLng', 'rsvpYesCount', 'rsvpMaybeCount',
               'rsvpNoCount', 'myRsvp', 'albumPhotos', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'ownerId', 'groupId', 'title', 'location', 'meetingPoint',
               'dateIso', 'time', 'status', 'budgetPerPerson', 'kitItems',
               'additionalInfo', 'placePhotoUrl', 'destLat', 'destLng',
               'meetLat', 'meetLng', 'rsvpYesCount', 'rsvpMaybeCount',
               'rsvpNoCount', 'myRsvp', 'rsvpByUser', 'albumPhotos', 'createdAt', 'updatedAt'
             ]) &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.groupId is string && data.groupId.size() >= 1 && data.groupId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.location is string && data.location.size() >= 1 && data.location.size() <= 200 &&
             data.meetingPoint is string && data.meetingPoint.size() <= 200 &&
             data.dateIso is string && data.dateIso.size() >= 8 && data.dateIso.size() <= 20 &&
             data.time is string && data.time.size() >= 1 && data.time.size() <= 20 &&
             data.status is string && data.status in ['CONFIRMED', 'PLANNED', 'CANCELLED'] &&
             data.budgetPerPerson is string && data.budgetPerPerson.size() <= 60 &&
             data.kitItems is string && data.kitItems.size() <= 500 &&
             data.additionalInfo is string && data.additionalInfo.size() <= 1000 &&
             data.placePhotoUrl is string && data.placePhotoUrl.size() <= 500 &&
             (data.destLat is int || data.destLat is float) &&
             (data.destLng is int || data.destLng is float) &&
             (data.meetLat is int || data.meetLat is float) &&
             (data.meetLng is int || data.meetLng is float) &&
             data.rsvpYesCount is int && data.rsvpYesCount >= 0 &&
             data.rsvpMaybeCount is int && data.rsvpMaybeCount >= 0 &&
             data.rsvpNoCount is int && data.rsvpNoCount >= 0 &&
             data.myRsvp is string && data.myRsvp in ['YES', 'MAYBE', 'NO', 'NONE'] &&
             (!('rsvpByUser' in data) || (data.rsvpByUser is map && data.rsvpByUser.size() <= 50)) &&
             isValidStringList(data.albumPhotos, 20) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /outings/{outingId} {
      allow get: if isSignedIn() && isValidId(outingId) &&
                    (existing().ownerId == request.auth.uid || isGroupMember(existing().groupId));
      allow list: if isSignedIn() &&
                     (resource.data.ownerId == request.auth.uid || isGroupMember(resource.data.groupId));

      allow create: if isSignedIn() &&
                       isValidId(outingId) &&
                       isValidOuting(incoming()) &&
                       incoming().ownerId == request.auth.uid;

      allow update: if isSignedIn() &&
                       isValidId(outingId) &&
                       isValidOuting(incoming()) &&
                       (existing().ownerId == request.auth.uid || isGroupMember(existing().groupId)) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'groupId', 'title', 'location', 'meetingPoint',
                         'dateIso', 'time', 'status', 'budgetPerPerson', 'kitItems',
                         'additionalInfo', 'placePhotoUrl', 'destLat', 'destLng',
                         'meetLat', 'meetLng', 'rsvpYesCount', 'rsvpMaybeCount',
                         'rsvpNoCount', 'myRsvp', 'rsvpByUser', 'albumPhotos', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(outingId) && existing().ownerId == request.auth.uid;
    }

    // 3. GroupChatMessage Validation Blueprint
    function isValidChatMessage(data) {
      return data.keys().hasAll([
               'senderId', 'senderName', 'groupId', 'text', 'messageType',
               'audioDurationSec', 'transcription', 'sharedOutingId',
               'sharedOutingTitle', 'reactions', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'senderId', 'senderName', 'groupId', 'text', 'messageType',
               'audioDurationSec', 'audioUrl', 'transcription', 'sharedOutingId',
               'sharedOutingTitle', 'reactions', 'createdAt', 'updatedAt'
             ]) &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 80 &&
             data.groupId is string && data.groupId.size() >= 1 && data.groupId.size() <= 128 &&
             data.text is string && data.text.size() <= 1000 &&
             data.messageType is string && data.messageType in ['TEXT', 'VOICE', 'OUTING_SHARE', 'STORY_REACTION'] &&
             data.audioDurationSec is int && data.audioDurationSec >= 0 &&
             (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 500)) &&
             data.transcription is string && data.transcription.size() <= 1000 &&
             data.sharedOutingId is string && data.sharedOutingId.size() <= 128 &&
             data.sharedOutingTitle is string && data.sharedOutingTitle.size() <= 120 &&
             isValidStringList(data.reactions, 10) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /chat_messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) &&
                    (existing().senderId == request.auth.uid || isGroupMember(existing().groupId));
      allow list: if isSignedIn() &&
                     (resource.data.senderId == request.auth.uid || isGroupMember(resource.data.groupId));

      allow create: if isSignedIn() &&
                       isValidId(messageId) &&
                       isValidChatMessage(incoming()) &&
                       incoming().senderId == request.auth.uid;

      allow update: if isSignedIn() &&
                       isValidId(messageId) &&
                       isValidChatMessage(incoming()) &&
                       incoming().senderId == existing().senderId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().senderId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['text', 'transcription', 'reactions', 'updatedAt'])) ||
                         (isGroupMember(existing().groupId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(messageId) && existing().senderId == request.auth.uid;
    }

    // 4. OutingStory Validation Blueprint
    function isValidStory(data) {
      return data.keys().hasAll([
               'authorId', 'authorName', 'caption', 'filterStyle',
               'mediaUri', 'outingTitle', 'likesCount', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'authorId', 'authorName', 'groupId', 'caption', 'filterStyle',
               'mediaUri', 'outingTitle', 'likesCount', 'createdAt', 'updatedAt'
             ]) &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             (!('groupId' in data) || (data.groupId is string && data.groupId.size() <= 128)) &&
             data.caption is string && data.caption.size() <= 300 &&
             data.filterStyle is string && data.filterStyle.size() <= 40 &&
             data.mediaUri is string && data.mediaUri.size() <= 500 &&
             data.outingTitle is string && data.outingTitle.size() <= 120 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId) &&
                    (existing().authorId == request.auth.uid || ('groupId' in existing() && isGroupMember(existing().groupId)));
      allow list: if isSignedIn() &&
                     (resource.data.authorId == request.auth.uid || ('groupId' in resource.data && isGroupMember(resource.data.groupId)));

      allow create: if isSignedIn() &&
                       isValidId(storyId) &&
                       isValidStory(incoming()) &&
                       incoming().authorId == request.auth.uid;

      allow update: if isSignedIn() &&
                       isValidId(storyId) &&
                       isValidStory(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().authorId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'likesCount', 'updatedAt'])) ||
                         ('groupId' in existing() && isGroupMember(existing().groupId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(storyId) && existing().authorId == request.auth.uid;
    }
  }
}
